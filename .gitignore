# Credential files. `.env` alone is not enough: Vite's loadEnv (see
# server/standalone/vite.config.js) and scripts/setup-doctor.mjs both read the
# full dotenv ladder — .env, .env.local, .env.<mode> and .env.<mode>.local —
# so a key placed in any of them is live for the app. Only .env was ignored,
# leaving the other three committable. .env.example is the tracked template.
.env
.env.*
!.env.example
*.log
screenshots/
qa-shots/
output/
.gev-logs/
.gev-cache/
.DS_Store
.gstack/
3d-models/
pinokio/ENVIRONMENT
pinokio/.installed
# Raw nationwide datasets (~2 GB) read by scripts/build-context-layers.mjs;
# only the per-county chunks it writes to public/context/ are served.
data/source/
# Plaintext research datasets (GVA 2015, MKDB): only their encrypted copies in
# data/research/ are committed (scripts/lock-research-data.mjs).
data/restricted/

# Downloaded Gaussian splat sample (CesiumJS test data; see public/splats/README.md)
public/splats/cesium-tower/
# 31 MB building-level export written by scripts/fetch-public-housing.mjs;
# regenerate locally (the app uses src/data/local_data/public_housing/).
data/exports/public_housing_buildings.csv
